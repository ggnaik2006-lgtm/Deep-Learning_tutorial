import tensorflow as tf
from tensorflow.keras.models import Sequential
from tensorflow.keras.layers import Dense,Flatten
from tensorflow.keras.datasets import mnist
from sklearn.metrics import accuracy_score

(x_train,y_train),(x_test,y_test)=mnist.load_data()
x_train=x_train/255.0
x_test=x_test/255.0

optimizers={
    "gradient descent":tf.keras.optimizers.SGD(learning_rate=0.01),
    "adam":tf.keras.optimizers.Adam(learning_rate=0.001),
    "momentum":tf.keras.optimizers.SGD(learning_rate=0.01,momentum=0.9),
    "rmsprop":tf.keras.optimizers.RMSprop(learning_rate=0.01),
}

result={}
for name,optimizer in optimizers.items():
  print("")
  model=Sequential([
      Flatten(input_shape=(28,28)),
      Dense(128,activation='relu'),
      Dense(10,activation='softmax')
  ])

  model.compile(optimizer=optimizer,loss='sparse_categorical_crossentropy',metrics=['accuracy'])
  loss_before,acc_before=model.evaluate(x_test,y_test)
  model.fit(x_train,y_train,epochs=5)
  loss_after,acc_after=model.evaluate(x_test,y_test)
  result[name]={
      "loss_before":loss_before,
      "acc_before":acc_before,
      "loss_after":loss_after,
      "acc_after":acc_after
  }

for method,metrics in result.items():
  print(f"{method}:")
  print(f"Loss before training: {metrics['loss_before']:.4f}")
  print(f"Accuracy before training: {metrics['acc_before']:.4f}")
  print(f"Loss after training: {metrics['loss_after']:.4f}")
  print(f"accuracy after training: {metrics['acc_after']:.4f}")
