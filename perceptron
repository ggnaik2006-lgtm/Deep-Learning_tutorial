import numpy as np
def activation(x):
  if x>=0:
    return 1
  else:
    return 0;
def perceptron(X,Y,epochs):
  w=np.zeros(X.shape[1])
  b=0
  lr=0.10
  for epoch in range(epochs):
    total_error=0
    for i in range(len(X)):
      y=activation(np.dot(X[i],w)+b)
      error=Y[i]-y
      total_error +=abs(error)
      w=w+lr*error*X[i]
      b=b+lr*error
    if total_error==0:
     break
    return w,b

        

X=np.array([[0,0],[0,1],[1,0],[1,1]])
Y=np.array([0,0,0,1])

w,b=perceptron(X,Y,10)
print("AND GATE")

for x in X:
  print(x,"=",activation(np.dot(x,w)+b))

Y=np.array([0,1,1,1])
